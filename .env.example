# Lark custom app credentials
LARK_APP_ID=cli_xxxxxxxxxxxxx
LARK_APP_SECRET=xxxxxxxxxxxxxxxx

# Attendance Records Base table
LARK_BASE_APP_TOKEN=bascnxxxxxxxxxxxx
LARK_ATTENDANCE_TABLE_ID=tblxxxxxxxxxxxx

# Custom Group Bot webhook for the external Lark group
LARK_GROUP_WEBHOOK=https://open.larksuite.com/open-apis/bot/v2/hook/xxxxxxxxxxxxxxxx

# Approved workplace geofence (MVP: one location)
SITE_NAME=Head Office
SITE_LATITUDE=14.000000
SITE_LONGITUDE=121.000000
SITE_RADIUS_METERS=100
MAX_GPS_ACCURACY_METERS=75

# Optional shared access code. Replace before rollout.
ATTENDANCE_ACCESS_CODE=change-me
